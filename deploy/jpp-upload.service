[Unit]
Description=Update COD 2026 JPP from uploaded Excel
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=importmitra
Group=importmitra
SupplementaryGroups=botcod-jpp
WorkingDirectory=/opt/import-mitra
EnvironmentFile=/opt/import-mitra/.env
Environment=JPP_UPLOAD_DIR=/opt/botCOD/data/jpp-upload
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/import-mitra/.venv/bin/python -m import_mitra process-jpp-upload
TimeoutStartSec=3600
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/import-mitra/runtime /opt/botCOD/data/jpp-upload
