# Salin menjadi .env. Semua path relatif terhadap folder ini.
MITRA_CONFIG=config/mitra.json
GOOGLE_CREDENTIALS_FILE=secrets/google-token.json
MITRA_STATE_DIR=runtime

# Tepat 3600 detik = setiap 1 jam. Jadwal dimulai ketika server hidup.
MITRA_INTERVAL_SECONDS=3600
MITRA_REFRESH_ON_START=true

# Dashboard hanya listen localhost. Akses lewat SSH tunnel atau reverse proxy HTTPS.
MITRA_HOST=127.0.0.1
MITRA_PORT=8080
MITRA_ADMIN_USER=admin
# Wajib diisi sebelum menjalankan server (minimal 16 karakter).
MITRA_ADMIN_PASSWORD=

# URL dashboard yang dapat diklik dari tab Kontrol; opsional.
MITRA_PUBLIC_URL=http://localhost:8080

# Batas aman Google API per jenis request, maksimal 50 per menit.
MITRA_API_REQUESTS_PER_MINUTE=45

# Opsional: setelah rekap selesai, perbarui 3 tab COD 2026 dengan kolom lamanya.
# Aktifkan hanya setelah sync-cod --dry-run diperiksa dan sync-cod pertama berhasil.
MITRA_SYNC_COD=false
MITRA_COD_PROFILE=config/cod2026.json
MITRA_COD_BACKUP_KEEP=24

